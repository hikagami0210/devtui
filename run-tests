#!/bin/sh
set -eu
cd -- "$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
if [ -n "${DEVTUI_PYTHON:-}" ]; then
    exec "$DEVTUI_PYTHON" -m unittest discover -s tests -v
fi
for candidate in python3.14 python3.13 python3.12 python3.11 python3; do
    if command -v "$candidate" >/dev/null 2>&1 && "$candidate" -c 'import sys; sys.exit(sys.version_info < (3, 11))' 2>/dev/null; then
        exec "$candidate" -m unittest discover -s tests -v
    fi
done
echo 'Tests require Python >= 3.11. Set DEVTUI_PYTHON to its executable path.' >&2
exit 1
